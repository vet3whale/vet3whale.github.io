---
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Resume — Vetri" description="Vetri's experience and education in computer engineering, embedded systems and AI.">
  <main class="resume-page">
    <a class="page-back" href={`${base}/`} aria-keyshortcuts="Escape">Home</a>
    <header class="page-heading">
      <h1>Resume</h1>
      <p class="resume-intro">Computer engineering, embedded systems and edge AI.</p>
      <nav class="resume-contact social-links" aria-label="Contact links">
        <a class="icon-link" href="https://www.linkedin.com/in/vetrivel-karthikeyan/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 1.15C0 .51.53 0 1.18 0h13.64C15.47 0 16 .51 16 1.15v13.7c0 .64-.53 1.15-1.18 1.15H1.18C.53 16 0 15.49 0 14.85V1.15Zm4.94 12.24V6.17H2.54v7.22h2.4ZM3.74 5.18c.84 0 1.36-.56 1.36-1.25-.02-.71-.52-1.25-1.34-1.25-.82 0-1.36.54-1.36 1.25 0 .69.52 1.25 1.31 1.25h.03Zm4.9 8.21V9.36c0-.22.02-.43.08-.59.17-.43.56-.88 1.22-.88.86 0 1.2.66 1.2 1.62v3.88h2.4V9.23c0-2.23-1.19-3.27-2.78-3.27-1.28 0-1.85.7-2.17 1.2v.03h-.02l.02-.03V6.17h-2.4c.03.66 0 7.22 0 7.22h2.4Z"></path></svg>
        </a>
        <a class="icon-link" href="https://github.com/vet3whale" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.64 5.47 7.71.4.08.55-.18.55-.39 0-.19-.01-.7-.01-1.38-2.23.49-2.7-1.09-2.7-1.09-.36-.94-.89-1.19-.89-1.19-.73-.5.05-.5.05-.5.81.06 1.23.84 1.23.84.72 1.25 1.88.89 2.34.68.07-.53.28-.89.51-1.09-1.78-.21-3.65-.9-3.65-4.02 0-.89.31-1.61.82-2.18-.08-.2-.36-1.03.08-2.15 0 0 .67-.22 2.2.83A7.53 7.53 0 0 1 8 3.93c.68 0 1.36.09 2 .27 1.53-1.05 2.2-.83 2.2-.83.44 1.12.16 1.95.08 2.15.51.57.82 1.29.82 2.18 0 3.13-1.88 3.81-3.66 4.01.29.25.54.75.54 1.51 0 1.09-.01 1.97-.01 2.24 0 .22.15.47.55.39A8.13 8.13 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z"></path></svg>
        </a>
        <a class="icon-link" href="mailto:vetrivel.karthikeyan@u.nus.edu" aria-label="Email Vetri" title="Email">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-.5a.5.5 0 0 0-.5.5v.22l6.5 3.9 6.5-3.9V4a.5.5 0 0 0-.5-.5H2Zm12.5 2.47-4.93 2.96 4.93 3V5.97Zm-.68 6.53L8 8.96 2.18 12.5h11.64ZM1.5 11.93l4.93-3-4.93-2.96v5.96Z"></path></svg>
        </a>
      </nav>
    </header>

    <section class="resume-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <ol class="resume-entries">
        <li class="resume-entry">
          <p class="resume-date"><time datetime="2026-05">May 2026</time> – <time datetime="2026-07">July 2026</time></p>
          <div class="resume-entry-body">
            <h3>ST Engineering</h3>
            <p class="resume-role">AI &amp; Robotics Intern</p>
            <ul class="resume-details">
              <li>Trained reinforcement learning policies for Unitree B2W locomotion.</li>
              <li>Distilled teacher policies into depth-based student models and validated them in simulation.</li>
              <li>Prepared ROS 2 inference pipelines for future hardware deployment.</li>
            </ul>
            <a class="resume-link" href={`${base}/projects/eg3612/`}>Internship project</a>
          </div>
        </li>
        <li class="resume-entry">
          <p class="resume-date"><time datetime="2025-08">Aug 2025</time> – <time datetime="2026-05">May 2026</time></p>
          <div class="resume-entry-body">
            <h3>National University of Singapore</h3>
            <p class="resume-role">Teaching Assistant</p>
            <ul class="resume-details">
              <li>CS1010: Led C programming tutorials and labs.</li>
              <li>CG1111A: Supported lab sessions and graded reports.</li>
              <li>CG2111A: Guided embedded programming and networking labs.</li>
            </ul>
          </div>
        </li>
      </ol>
    </section>

    <section class="resume-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ol class="resume-entries">
        <li class="resume-entry">
          <p class="resume-date"><time datetime="2024-08">Aug 2024</time> – Present</p>
          <div class="resume-entry-body">
            <h3>National University of Singapore</h3>
            <p class="resume-role">Bachelor of Engineering (Hons) in Computer Engineering</p>
            <p>CGPA: 4.59/5.00</p>
            <p>Minor in AI. Specialisation in Advanced Electronics.</p>
            <a class="resume-link" href={`${base}/projects/`}>Projects</a>
          </div>
        </li>
      </ol>
    </section>
    <section class="resume-section" aria-labelledby="certifications-heading">
      <h2 id="certifications-heading">Certifications</h2>
      <ul class="resume-certifications">
        <li>CS50's Introduction to Programming with Python (CS50P)</li>
        <li>Google Cloud Generative AI Leader Certification</li>
      </ul>
    </section>
  </main>
</Base>
