---
import ProjectCard from "../../components/ProjectCard.astro";
import { projects, projectYears } from "../../data/projects";
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Projects — Vetri" description="Projects by Vetri.">
  <main class="projects-page">
    <a class="page-back" href={`${base}/`}>Home</a>
    <header class="page-heading">
      <h1>Projects</h1>
    </header>
    {projectYears.map((year) => (
      <section class="project-year" aria-labelledby={`projects-${year}`}>
        <h2 id={`projects-${year}`}>{year}</h2>
        <div class="project-grid">
          {projects
            .filter((project) => project.year === year)
            .sort((a, b) => Number(b.kind === "internship") - Number(a.kind === "internship"))
            .map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
