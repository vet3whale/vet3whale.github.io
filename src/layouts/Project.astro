---
import { Image } from "astro:assets";
import ProjectText from "../components/ProjectText.astro";
import type { Project } from "../data/projects";
import Base from "./Base.astro";

interface Props { project: Project }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title={`${project.title} — Vetri`} description={project.summary}>
  <main class="project-page">
    <a class="page-back" href={`${base}/projects/`} aria-keyshortcuts="Escape">Projects</a>
    <article>
      <header class="project-heading">
        <h1><ProjectText text={project.title} /></h1>
      </header>
      <div class:list={["project-overview", { "without-image": !project.image }]}>
        <div class="project-description">
          {project.purpose && <p><strong>Purpose</strong>: {project.purpose}.</p>}
          <p>{project.description}</p>
          {project.workflow && (
            <figure class="project-workflow">
              <button class="workflow-expand" type="button" aria-label="Expand training workflow" aria-haspopup="dialog" aria-controls="workflow-dialog">
              <Image
                src={project.workflow.src}
                alt={project.workflow.alt}
                widths={[480, 768, 1183]}
                sizes="(max-width: 700px) 100vw, 42rem"
                format="webp"
                quality={88}
                loading="eager"
                decoding="async"
              />
              </button>
              <dialog id="workflow-dialog" class="workflow-dialog" aria-label="Training workflow">
                <form method="dialog"><button class="workflow-close" autofocus>Close</button></form>
                <img src={project.workflow.src.src} alt={project.workflow.alt} width={project.workflow.src.width} height={project.workflow.src.height} />
              </dialog>
            </figure>
          )}
          {project.repository && (
            <a class="project-repository" href={project.repository} target="_blank" rel="noopener noreferrer">
              View code on GitHub
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )}
        </div>
        {project.image && (
          <figure class="project-photo">
            <Image
              src={project.image.src}
              alt={project.image.alt}
              widths={[120, 200, 320, 480, 640]}
              sizes="(max-width: 544px) 28vw, 12rem"
              format="webp"
              quality={82}
              loading="eager"
              decoding="async"
            />
          </figure>
        )}
      </div>
      <table class="project-facts">
        <caption>At a glance</caption>
        <tbody>
          {project.facts.map(({ label, value }) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{value}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="module-note">
        Completed in {project.year} as part of {project.module}: {project.moduleName} at NUS.
      </p>
      <section class="project-documents" aria-labelledby="documents-heading">
        <h2 id="documents-heading">Documents</h2>
        {project.documents.map((document) => (
          <details class="pdf-disclosure">
            <summary>{document.label}</summary>
            <div class="pdf-panel">
              <a href={document.url} target="_blank" rel="noreferrer">{document.linkLabel}</a>
              <iframe
                class="pdf-viewer"
                src={document.url}
                title={`${project.title} — ${document.label}`}
                loading="lazy"
              ></iframe>
            </div>
          </details>
        ))}
      </section>
    </article>
  </main>
</Base>

<script>
  const workflowButton = document.querySelector<HTMLButtonElement>(".workflow-expand");
  const workflowDialog = document.querySelector<HTMLDialogElement>("#workflow-dialog");
  if (workflowButton && workflowDialog) {
    workflowButton.addEventListener("click", () => workflowDialog.showModal());
    workflowDialog.addEventListener("click", (event) => {
      if (event.target === workflowDialog) {
        const bounds = workflowDialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) workflowDialog.close();
      }
    });
  }
</script>
